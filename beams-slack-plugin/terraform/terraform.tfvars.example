# Copy to terraform.tfvars (git-ignored) and fill in. Or pass secrets as
# TF_VAR_slack_bot_token / TF_VAR_slack_app_token environment variables.

teleport_proxy = "example-beams-tenant.beams.sh:443"
plugin_image   = "registry.example.com/beams-slack-plugin:sha-0000000"

slack_bot_token = "xoxb-..."
slack_app_token = "xapp-..."

# Deploy to a remote Docker host over SSH instead of the local daemon.
# docker_host = "ssh://user@docker-host"

# Needed if plugin_image is in a private registry.
# registry_auth = {
#   address  = "registry.example.com"
#   username = "deploy"
#   password = "..."
# }
