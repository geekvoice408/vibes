+	require.NotContains(t, string(calls), "--identity=/plugin-identity")
+	require.Contains(t, string(calls), "beams exec mine uname -a")
+	require.Contains(t, string(calls), `beams exec mine 'claude' '-p' '--dangerously-skip-permissions' '--continue' 'what'\''s failing?'`)
+
+	// An expired session is forgotten and the user is asked again.
+	profile := filepath.Join(runner.Config.ProfilesDir, "T1", "UALICE")
+	require.NoError(t, os.WriteFile(filepath.Join(profile, "delegation-session"), []byte("99999999-2222-3333-4444-555555555555"), 0o600))
+	out, err = runner.Run(ctx, "T1", "UALICE", "ls")
+	require.NoError(t, err)
+	require.Contains(t, out, "Your authorization has expired. Before we can get started")
+	out, err = runner.Run(ctx, "T1", "UALICE", "status")
+	require.NoError(t, err)
+	require.Equal(t, "Not connected. Run `/beams connect`.", out)
+}
+
+func TestBeamsRetryUntilReady(t *testing.T) {
+	oldPoll := beamReadyPoll
+	beamReadyPoll = 10 * time.Millisecond
+	t.Cleanup(func() { beamReadyPoll = oldPoll })
+
+	dir := t.TempDir()
+	counter := filepath.Join(dir, "attempts")
+	tshPath := filepath.Join(dir, "tsh")
+	script := `#!/bin/sh
+n=$(cat ` + counter + ` 2>/dev/null || echo 0)
+n=$((n+1))
+echo $n > ` + counter + `
+if [ $n -le 2 ]; then
+  echo 'ERROR: beam "fresh" is not ready to accept SSH connections' >&2
+  exit 1
+fi
+echo ready
+`
+	require.NoError(t, os.WriteFile(tshPath, []byte(script), 0o700))
+
+	s := beamsSession{
+		runner:     BeamsCommandRunner{Config: BeamsConfig{TSHPath: tshPath}},
+		profileDir: dir,
+	}
+	out, err := s.tsh(t.Context(), "/identity", "beams", "exec", "fresh", "true")
+	require.NoError(t, err)
+	require.Equal(t, "ready\n", out)
+	attempts, err := os.ReadFile(counter)
+	require.NoError(t, err)
+	require.Equal(t, "3\n", string(attempts))
+}
diff --git a/integrations/access/slack/beams_scotty.go b/integrations/access/slack/beams_scotty.go
new file mode 100644
index 00000000000..2910b8d77ae
--- /dev/null
+++ b/integrations/access/slack/beams_scotty.go
@@ -0,0 +1,357 @@
+package slack
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/gravitational/trace"
+)
+
+// scottyActionPrefix marks lines in Claude's reply that ask the plugin to act
+// on the beam from outside, which Claude cannot do from inside the VM.
+const scottyActionPrefix = "SCOTTY_ACTION:"
+
+var (
+	sessionIDText = regexp.MustCompile(`[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}`)
+	slackMention  = regexp.MustCompile(`<@[A-Z0-9]+>`)
+	scottyPrefix  = regexp.MustCompile(`(?i)^\s*scotty\b[\s,:]*`)
+	safeThreadKey = regexp.MustCompile(`^[A-Z0-9]+-[0-9.]+$`)
+
+	// Questions about which beams the user has are answered from tsh beams ls
+	// directly, without a Claude run. Requests that act on beams go to Claude.
+	beamsListQuestion = regexp.MustCompile(`(?i)\b(list|show|what|which|how many|do i have)\b`)
+	beamsPlural       = regexp.MustCompile(`(?i)\bbeams\b`)
+	beamsActionWord   = regexp.MustCompile(`(?i)\b(create|make|build|new|add|publish|unpublish|deploy|run|install|write|delete|remove|rm|start|stop|fix|update|change|set up|setup)\b`)
+)
+
+// scottyRequest extracts the request from a Slack message addressed to the
+// bot. Mentions, direct messages, and replies in a thread the user already
+// has with Scotty (followUp) always count; other channel messages count only
+// when they start with "scotty".
+func scottyRequest(event BeamsMessageEvent, followUp bool) (string, bool) {
+	if event.User == "" || event.BotID != "" || event.Subtype != "" {
+		return "", false
+	}
+	text := strings.TrimSpace(slackMention.ReplaceAllString(event.Text, ""))
+	switch {
+	case event.EventType == "app_mention", event.ChannelType == "im", followUp:
+		text = scottyPrefix.ReplaceAllString(text, "")
+	case scottyPrefix.MatchString(event.Text):
+		text = scottyPrefix.ReplaceAllString(event.Text, "")
+	default:
+		return "", false
+	}
+	text = strings.TrimSpace(text)
+	return text, text != ""
+}
+
+// FollowsThread reports whether a Slack user already has a Scotty
+// conversation in the thread, so their replies there need no mention.
+func (r BeamsCommandRunner) FollowsThread(teamID, userID, threadKey string) bool {
+	if !safeSlackID.MatchString(teamID) || !safeSlackID.MatchString(userID) || !safeThreadKey.MatchString(threadKey) {
+		return false
+	}
+	_, err := os.Stat(filepath.Join(r.Config.ProfilesDir, teamID, userID, "threads", threadKey))
+	return err == nil
+}
+
+// Ask handles a natural-language request. It picks one of the user's beams
+// (or creates one), hands the request to Claude Code there, and carries out
+// the actions Claude asks for. Requests in the same Slack thread continue the
+// same beam and Claude conversation.
+func (r BeamsCommandRunner) Ask(ctx context.Context, teamID, userID, threadKey, text string) (string, error) {
+	if !safeThreadKey.MatchString(threadKey) {
+		return "", trace.BadParameter("invalid Slack thread")
+	}
+	s, err := r.newSession(ctx, teamID, userID)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+
+	threadsDir := filepath.Join(s.profileDir, "threads")
+	if err := os.MkdirAll(threadsDir, 0o700); err != nil {
+		return "", trace.Wrap(err)
+	}
+	pendingPath := filepath.Join(threadsDir, threadKey+".pending")
+
+	// Scotty only works as the user, so beams it creates are owned by them and
+	// their published URLs are reachable. Until the user authorizes the bot,
+	// hold the request and explain how.
+	var notes []string
+	if s.delegation == "" {
+		id := sessionIDText.FindString(text)
+		if id == "" {
+			return s.requestAuthorization(threadKey, pendingPath, text)
+		}
+		if _, err := s.connect(ctx, []string{id}); err != nil {
+			return "", trace.Wrap(err, "connecting delegation session")
+		}
+		s.delegation = strings.ToLower(id)
+		pending, _ := os.ReadFile(pendingPath)
+		_ = os.Remove(pendingPath)
+		if strings.TrimSpace(string(pending)) == "" {
+			return fmt.Sprintf("Thanks, you're connected as %s. What would you like me to do?", s.username), nil
+		}
+		notes = append(notes, fmt.Sprintf("Thanks, you're connected as %s.", s.username))
+		text = string(pending)
+	}
+
+	beams, err := s.delegatedBeams(ctx)
+	if needsAuthorization(err) {
+		return s.requestAuthorization(threadKey, pendingPath, text)
+	}
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	if isBeamsListQuestion(text) {
+		threadPath := filepath.Join(threadsDir, threadKey)
+		if _, err := os.Stat(threadPath); os.IsNotExist(err) {
+			if err := os.WriteFile(threadPath, nil, 0o600); err != nil {
+				return "", trace.Wrap(err)
+			}
+		}
+		return truncateSlackOutput(strings.Join(append(notes, formatBeamsList(beams, time.Now())), "\n\n")), nil
+	}
+
+	// The thread file holds the thread's beam, plus "new" when Scotty switched
+	// the thread to a beam that has no Claude conversation yet.
+	threadPath := filepath.Join(s.profileDir, "threads", threadKey)
+	var threadBeam string
+	fresh := false
+	if previous, err := os.ReadFile(threadPath); err == nil {
+		if fields := strings.Fields(string(previous)); len(fields) > 0 {
+			threadBeam = fields[0]
+			fresh = len(fields) > 1 && fields[1] == "new"
+		}
+	}
+	name, continued := chooseBeam(beams, threadBeam, text)
+	if fresh && name == threadBeam {
+		continued = false
+	}
+
+	created := false
+	if name == "" {
+		_, name, err = s.createBeam(ctx, nil)
+		if err != nil {
+			return "", trace.Wrap(err, "creating a beam")
+		}
+		created = true
+		notes = append(notes, fmt.Sprintf("Created beam `%s`.", name))
+	}
+	// Mark the beam "new" until a Claude run succeeds there, so a failed first
+	// run is not followed by --continue.
+	marker := name
+	if !continued {
+		marker += " new"
+	}
+	if err := os.WriteFile(threadPath, []byte(marker), 0o600); err != nil {
+		return "", trace.Wrap(err)
+	}
+
+	claudeArgs := []string{name}
+	if continued {
+		claudeArgs = append(claudeArgs, "--continue")
+	}
+	claudeArgs = append(claudeArgs, scottyPrompt(name, s.username, created, text))
+	output, err := s.claude(ctx, claudeArgs)
+	if err != nil {
+		return "", trace.Wrap(err, "running Claude Code in beam %q", name)
+	}
+	if err := os.WriteFile(threadPath, []byte(name), 0o600); err != nil {
+		return "", trace.Wrap(err)
+	}
+
+	reply, actions := parseScottyActions(output)
+	var actionNotes []string
+	for _, action := range actions {
+		note, newBeam, err := s.scottyAction(ctx, name, action)
+		if err != nil {
+			note = fmt.Sprintf("Could not %s: %s", action, trace.UserMessage(err))
+		}
+		actionNotes = append(actionNotes, note)
+		if newBeam != "" {
+			// Follow-ups in this thread should work in the beam the user asked
+			// for, starting a new Claude conversation there.
+			name = newBeam
+			if err := os.WriteFile(threadPath, []byte(name+" new"), 0o600); err != nil {
+				return "", trace.Wrap(err)
+			}
+		}
+	}
+
+	parts := append(notes, reply)
+	parts = append(parts, actionNotes...)
+	return truncateSlackOutput(strings.TrimSpace(strings.Join(parts, "\n\n"))), nil
+}
+
+// requestAuthorization saves the request for later and asks the user to let
+// the bot create beams as them. It records the thread so the user's reply
+// with the session ID is picked up without a mention.
+func (s beamsSession) requestAuthorization(threadKey, pendingPath, request string) (string, error) {
+	if s.runner.Config.BotName == "" {
+		return "", trace.BadParameter("delegation is not configured; set beams.bot_name")
+	}
+	if err := os.WriteFile(pendingPath, []byte(request), 0o600); err != nil {
+		return "", trace.Wrap(err)
+	}
+	threadPath := filepath.Join(s.profileDir, "threads", threadKey)
+	if _, err := os.Stat(threadPath); os.IsNotExist(err) {
+		if err := os.WriteFile(threadPath, nil, 0o600); err != nil {
+			return "", trace.Wrap(err)
+		}
+	}
+	return s.authorizationReply("Then reply here with the session ID it prints and I'll pick up your request."), nil
+}
+
+// isBeamsListQuestion reports whether a request only asks which beams the
+// user has.
+func isBeamsListQuestion(text string) bool {
+	return beamsPlural.MatchString(text) && beamsListQuestion.MatchString(text) && !beamsActionWord.MatchString(text)
+}
+
+// formatBeamsList describes the user's beams for Slack.
+func formatBeamsList(beams []map[string]any, now time.Time) string {
+	if len(beams) == 0 {
+		return "You don't have any beams yet. Ask me to create one."
+	}
+	var b strings.Builder
+	if len(beams) == 1 {
+		b.WriteString("You have *1 beam*:")
+	} else {
+		fmt.Fprintf(&b, "You have *%d beams*:", len(beams))
+	}
+	for _, beam := range beams {
+		id, _ := beam["id"].(string)
+		fmt.Fprintf(&b, "\n• `%s`", id)
+		if region, _ := beam["region"].(string); region != "" {
+			fmt.Fprintf(&b, " (%s)", region)
+		}
+		if expires, _ := beam["expires"].(string); expires != "" {
+			if t, err := time.Parse(time.RFC3339Nano, expires); err == nil {
+				fmt.Fprintf(&b, ", expires in %s", humanDuration(t.Sub(now)))
+			}
+		}
+		if url, _ := beam["url"].(string); url != "" {
+			fmt.Fprintf(&b, ", published at %s", url)
+		}
+	}
+	return b.String()
+}
+
+func humanDuration(d time.Duration) string {
+	switch {
+	case d < time.Minute:
+		return "less than a minute"
+	case d < time.Hour:
+		return plural(int(d.Round(time.Minute)/time.Minute), "minute")
+	default:
+		return plural(int(d.Round(time.Hour)/time.Hour), "hour")
+	}
+}
+
+func plural(n int, unit string) string {
+	if n == 1 {
+		return "1 " + unit
+	}
+	return fmt.Sprintf("%d %ss", n, unit)
+}
+
+// chooseBeam picks the beam for a request: the thread's beam, a beam named in
+// the request, or the user's newest beam. continued reports whether the
+// thread already has a Claude conversation in that beam.
+func chooseBeam(beams []map[string]any, threadBeam, text string) (name string, continued bool) {
+	var newest, newestExpiry string
+	for _, beam := range beams {
+		id, _ := beam["id"].(string)
+		if id == "" {
+			continue
+		}
+		if id == threadBeam {
+			return id, true
+		}
+		if strings.Contains(text, id) {
+			name = id
+		}
+		if expires, _ := beam["expires"].(string); newest == "" || expires > newestExpiry {
+			newest, newestExpiry = id, expires
+		}
+	}
+	if name != "" {
+		return name, false
+	}
+	return newest, false
+}
+
+func scottyPrompt(beam, username string, created bool, request string) string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "You are Scotty, a Slack assistant working inside the Teleport Beam %q, an ephemeral Debian runtime, on behalf of %s.", beam, username)
+	if created {
+		b.WriteString(" This beam was just created for this request.")
+	}
+	b.WriteString(`
+Carry out the request below in this runtime. Your final reply is posted to Slack, so keep it short and use Slack formatting. Reply to the user directly: do not restate their request or explain these instructions. If you mention this environment, call it a runtime, not a sandbox.
+To share a web page or service, serve it on port 8080 on 0.0.0.0 in the background so it keeps running after you exit (for example with nohup or tmux), then request publishing.
+You cannot manage beams yourself. To have the Slack bot act for you, end your reply with one line per action:
+` + scottyActionPrefix + ` publish
+` + scottyActionPrefix + ` unpublish
+` + scottyActionPrefix + ` create_beam
+Only request create_beam if the user explicitly asks for an additional beam.
+
+Request: `)
+	b.WriteString(request)
+	return b.String()
+}
+
+// parseScottyActions separates action lines from Claude's reply.
+func parseScottyActions(output string) (string, []string) {
+	var reply []string
+	var actions []string
+	for _, line := range strings.Split(output, "\n") {
+		if action, ok := strings.CutPrefix(strings.TrimSpace(line), scottyActionPrefix); ok {
+			if action = strings.TrimSpace(action); action != "" {
+				actions = append(actions, action)
+			}
+			continue
+		}
+		reply = append(reply, line)
+	}
+	return strings.TrimSpace(strings.Join(reply, "\n")), actions
+}
+
+// scottyAction runs one action Claude requested. newBeam is set when the
+// action created a beam.
+func (s beamsSession) scottyAction(ctx context.Context, beam, action string) (note, newBeam string, err error) {
+	switch action {
+	case "publish":
+		out, err := s.target(ctx, []string{"publish", beam, "--format=json"})
+		if err != nil {
+			return "", "", trace.Wrap(err)
+		}
+		var published struct {
+			URL string `json:"url"`
+		}
+		if json.Unmarshal([]byte(out), &published) == nil && published.URL != "" {
+			return fmt.Sprintf("Published: %s", published.URL), "", nil
+		}
+		return fmt.Sprintf("Published `%s`.", beam), "", nil
+	case "unpublish":
+		if _, err := s.target(ctx, []string{"unpublish", beam}); err != nil {
+			return "", "", trace.Wrap(err)
+		}
+		return fmt.Sprintf("Unpublished `%s`.", beam), "", nil
+	case "create_beam":
+		_, name, err := s.createBeam(ctx, nil)
+		if err != nil {
+			return "", "", trace.Wrap(err)
+		}
+		return fmt.Sprintf("Created beam `%s`. This thread now works in it.", name), name, nil
+	default:
+		return "", "", trace.BadParameter("unsupported action %q", action)
+	}
+}
diff --git a/integrations/access/slack/beams_scotty_test.go b/integrations/access/slack/beams_scotty_test.go
new file mode 100644
index 00000000000..439a343a0b3
--- /dev/null
+++ b/integrations/access/slack/beams_scotty_test.go
@@ -0,0 +1,271 @@
+package slack
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gravitational/trace"
+	"github.com/stretchr/testify/require"
+)
+
+func TestScottyRequest(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		event    BeamsMessageEvent
+		followUp bool
+		want     string
+	}{
+		{name: "mention", event: BeamsMessageEvent{EventType: "app_mention", User: "U1", Text: "<@UBOT> create a beam"}, want: "create a beam"},
+		{name: "dm", event: BeamsMessageEvent{EventType: "message", ChannelType: "im", User: "U1", Text: "list my beams"}, want: "list my beams"},
+		{name: "channel prefix", event: BeamsMessageEvent{EventType: "message", ChannelType: "channel", User: "U1", Text: "Scotty, make a page"}, want: "make a page"},
+		{name: "channel chatter", event: BeamsMessageEvent{EventType: "message", ChannelType: "channel", User: "U1", Text: "lunch?"}},
+		{name: "scottyish word", event: BeamsMessageEvent{EventType: "message", ChannelType: "channel", User: "U1", Text: "scottys idea"}},
+		{name: "bot message", event: BeamsMessageEvent{EventType: "message", ChannelType: "im", User: "U1", BotID: "B1", Text: "hi"}},
+		{name: "edit", event: BeamsMessageEvent{EventType: "message", ChannelType: "im", User: "U1", Subtype: "message_changed", Text: "hi"}},
+		{name: "empty mention", event: BeamsMessageEvent{EventType: "app_mention", User: "U1", Text: "<@UBOT>"}},
+		{name: "thread follow-up", followUp: true, event: BeamsMessageEvent{EventType: "message", ChannelType: "channel", User: "U1", ThreadTS: "1.2", Text: "how's that going?"}, want: "how's that going?"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, ok := scottyRequest(tc.event, tc.followUp)
+			require.Equal(t, tc.want != "", ok)
+			require.Equal(t, tc.want, got)
+		})
+	}
+}
+
+func TestParseScottyActions(t *testing.T) {
+	reply, actions := parseScottyActions("Done.\n  SCOTTY_ACTION: publish\nSee it soon.\nSCOTTY_ACTION:\n")
+	require.Equal(t, "Done.\nSee it soon.", reply)
+	require.Equal(t, []string{"publish"}, actions)
+}
+
+func TestChooseBeam(t *testing.T) {
+	beams := []map[string]any{
+		{"id": "old", "expires": "2026-10-02T01:00:00Z"},
+		{"id": "new", "expires": "2026-10-02T09:00:00Z"},
+	}
+	name, continued := chooseBeam(beams, "old", "anything")
+	require.Equal(t, "old", name)
+	require.True(t, continued)
+
+	name, continued = chooseBeam(beams, "gone", "do it in old please")
+	require.Equal(t, "old", name)
+	require.False(t, continued)
+
+	name, _ = chooseBeam(beams, "", "make a page")
+	require.Equal(t, "new", name)
+
+	name, _ = chooseBeam(nil, "", "make a page")
+	require.Empty(t, name)
+}
+
+const testSessionID = "11111111-2222-3333-4444-555555555555"
+
+// fakeMint accepts only testSessionID, like a delegation session the user
+// created for the bot.
+func fakeMint(_ context.Context, sessionID, _ string, path string) error {
+	if sessionID != testSessionID {
+		return trace.AccessDenied("delegation session is not valid")
+	}
+	return os.WriteFile(path, []byte("delegated"), 0o600)
+}
+
+func TestScottyAsk(t *testing.T) {
+	tshPath, logPath := writeFakeTSH(t)
+	runner := BeamsCommandRunner{
+		Config: BeamsConfig{
+			TSHPath:        tshPath,
+			Proxy:          "example.teleport.sh:443",
+			PluginIdentity: "/plugin-identity",
+			ProfilesDir:    t.TempDir(),
+			BotName:        "scotty",
+			DelegationTTL:  "168h",
+			Users:          map[string]string{"UALICE": "alice@example.com"},
+		},
+		MintIdentity: fakeMint,
+	}
+	ctx := t.Context()
+	thread := "C1-1700000000.000100"
+
+	// Not connected: Scotty asks for authorization instead of acting as the bot.
+	out, err := runner.Ask(ctx, "T1", "UALICE", thread, "make a webpage about Seattle and publish it")
+	require.NoError(t, err)
+	require.Contains(t, out, "Before we can get started, you need to allow me to create beams as you.")
+	require.Contains(t, out, "tsh delegation create-session --proxy=example.teleport.sh:443 --bot=scotty --allow-all --session-ttl=168h")
+	require.True(t, runner.FollowsThread("T1", "UALICE", thread), "the reply with the session ID must be picked up without a mention")
+	_, err = os.Stat(logPath)
+	require.True(t, os.IsNotExist(err), "no tsh commands may run before the user connects")
+
+	// A bad ID is rejected and the request stays pending.
+	_, err = runner.Ask(ctx, "T1", "UALICE", thread, "here you go 99999999-2222-3333-4444-555555555555")
+	require.Error(t, err)
+
+	// Pasting the session ID connects and resumes the original request.
+	out, err = runner.Ask(ctx, "T1", "UALICE", thread, "here you go "+testSessionID)
+	require.NoError(t, err)
+	require.Contains(t, out, "Thanks, you're connected as alice@example.com.")
+	require.Contains(t, out, "Built the page.")
+	require.Contains(t, out, "Published: https://mine.example")
+	require.NotContains(t, out, "SCOTTY_ACTION")
+	require.NotContains(t, out, "beam:")
+
+	_, err = runner.Ask(ctx, "T1", "UALICE", thread, "make the title bigger")
+	require.NoError(t, err)
+
+	calls, err := os.ReadFile(logPath)
+	require.NoError(t, err)
+	require.NotContains(t, string(calls), "--identity=/plugin-identity", "Scotty must never act as the bot")
+	require.Contains(t, string(calls), "Request: make a webpage about Seattle and publish it'", "the pending request runs after connecting")
+	require.Contains(t, string(calls), "beams publish mine --format=json")
+	require.Contains(t, string(calls), "'--continue' 'You are Scotty")
+
+	_, err = runner.Ask(ctx, "T1", "UALICE", "../escape", "hi")
