+
+package slack
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+
+	"github.com/gravitational/trace"
+
+	delegationv1 "github.com/gravitational/teleport/api/gen/proto/go/teleport/delegation/v1"
+	"github.com/gravitational/teleport/integrations/access/common"
+	"github.com/gravitational/teleport/integrations/lib"
+	"github.com/gravitational/teleport/integrations/lib/logger"
+)
+
+// BeamsBot defines the Slack operations used by the Beams slash-command app.
+type BeamsBot interface {
+	GenerateWebSocketURL(ctx context.Context) (string, error)
+	PostBeamsReply(ctx context.Context, responseURL, text string) error
+}
+
+type beamsRunner interface {
+	Run(ctx context.Context, teamID, userID, text string) (string, error)
+}
+
+// BeamsApp consumes /beams commands from Slack Socket Mode.
+type BeamsApp struct {
+	conf             BeamsConfig
+	bot              BeamsBot
+	runner           beamsRunner
+	socketModeClient *SocketModeClient
+	job              lib.ServiceJob
+}
+
+// NewBeamsApp creates a Beams slash-command application.
+func NewBeamsApp(conf BeamsConfig) *BeamsApp {
+	app := &BeamsApp{
+		conf:   conf,
+		runner: BeamsCommandRunner{Config: conf},
+	}
+	app.job = lib.NewServiceJob(app.run)
+	return app
+}
+
+// Init initializes the Slack bot and Socket Mode client.
+func (a *BeamsApp) Init(baseApp *common.BaseApp) error {
+	var ok bool
+	a.bot, ok = baseApp.Bot.(BeamsBot)
+	if !ok {
+		return trace.BadParameter("bot does not support Beams slash commands")
+	}
+	a.socketModeClient = NewSocketModeClient(a.bot)
+	delegationClient, ok := baseApp.APIClient.(interface {
+		DelegationSessionServiceClient() delegationv1.DelegationSessionServiceClient
+	})
+	if !ok {
+		return trace.BadParameter("Teleport client does not support delegation sessions")
+	}
+	a.runner = BeamsCommandRunner{
+		Config:           a.conf,
+		DelegationClient: delegationClient.DelegationSessionServiceClient(),
+		ConnectMu:        &sync.Mutex{},
+	}
+	return nil
+}
+
+// Start starts the application.
+func (a *BeamsApp) Start(process *lib.Process) {
+	process.SpawnCriticalJob(a.job)
+}
+
+// WaitReady waits until the application is ready.
+func (a *BeamsApp) WaitReady(ctx context.Context) (bool, error) {
+	return a.job.WaitReady(ctx)
+}
+
+// WaitForDone waits for the application to stop.
+func (a *BeamsApp) WaitForDone() {
+	<-a.job.Done()
+}
+
+// Err returns the application error.
+func (a *BeamsApp) Err() error {
+	return a.job.Err()
+}
+
+func (a *BeamsApp) run(ctx context.Context) error {
+	process := lib.MustGetProcess(ctx)
+	ctx, cancel := context.WithCancel(ctx)
+	process.OnTerminate(func(context.Context) error {
+		cancel()
+		return nil
+	})
+
+	log := logger.Get(ctx)
+	a.job.SetReady(true)
+	log.InfoContext(ctx, "Beams slash-command app is running")
+
+	go func() {
+		for {
+			select {
+			case interaction := <-a.socketModeClient.Interactions():
+				event, ok := interaction.(SlashCommandEvent)
+				if !ok {
+					continue
+				}
+				if event.Command != "/beams" {
+					continue
+				}
+				go a.handleSlashCommand(ctx, event)
+			case <-ctx.Done():
+				return
+			}
+		}
+	}()
+
+	return trace.Wrap(a.socketModeClient.Run(ctx))
+}
+
+func (a *BeamsApp) handleSlashCommand(ctx context.Context, event SlashCommandEvent) {
+	log := logger.Get(ctx).With(
+		"slack_team_id", event.TeamID,
+		"slack_user_id", event.UserID,
+		"slack_channel_id", event.ChannelID,
+	)
+	log.InfoContext(ctx, "Executing Beams slash command")
+
+	output, err := a.runner.Run(ctx, event.TeamID, event.UserID, event.Text)
+	if err != nil {
+		output = fmt.Sprintf("Beams command failed: %s", trace.UserMessage(err))
+		log.WarnContext(ctx, "Beams slash command failed", "error", err)
+	}
+
+	if err := a.bot.PostBeamsReply(ctx, event.ResponseURL, formatBeamsReply(output)); err != nil {
+		log.ErrorContext(ctx, "Failed to post Beams command response", "error", err)
+	}
+}
+
+func formatBeamsReply(output string) string {
+	output = strings.TrimSpace(output)
+	if strings.HasPrefix(output, "/beams ") || !strings.Contains(output, "\n") {
+		return output
+	}
+	return "```" + output + "```"
+}
diff --git a/integrations/access/slack/beams_commands.go b/integrations/access/slack/beams_commands.go
new file mode 100644
index 0000000000..40f7ae5d05
--- /dev/null
+++ b/integrations/access/slack/beams_commands.go
@@ -0,0 +1,353 @@
+package slack
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/gravitational/trace"
+	"github.com/mattn/go-shellwords"
+	"golang.org/x/crypto/ssh"
+	"google.golang.org/protobuf/types/known/durationpb"
+
+	delegationv1 "github.com/gravitational/teleport/api/gen/proto/go/teleport/delegation/v1"
+	"github.com/gravitational/teleport/api/identityfile"
+	"github.com/gravitational/teleport/api/utils/keys"
+)
+
+const defaultBeamsCommandTimeout = 2 * time.Minute
+
+var safeSlackID = regexp.MustCompile(`^[A-Z0-9]+$`)
+var loginURLPattern = regexp.MustCompile(`https://[^\s]+`)
+
+// BeamsCommandRunner executes non-interactive tsh beams commands with a
+// Teleport profile isolated to one Slack workspace/user pair.
+type BeamsCommandRunner struct {
+	Config           BeamsConfig
+	DelegationClient delegationv1.DelegationSessionServiceClient
+	ConnectMu        *sync.Mutex
+}
+
+func (r BeamsCommandRunner) Run(ctx context.Context, teamID, userID, text string) (string, error) {
+	if !safeSlackID.MatchString(teamID) || !safeSlackID.MatchString(userID) {
+		return "", trace.BadParameter("invalid Slack identity")
+	}
+	words, err := shellwords.Parse(text)
+	if err != nil {
+		return "", trace.BadParameter("invalid command: %v", err)
+	}
+	if len(words) == 0 || words[0] == "help" {
+		return beamsHelp(), nil
+	}
+
+	profileDir := filepath.Join(r.Config.ProfilesDir, teamID, userID)
+	if err := os.MkdirAll(profileDir, 0o700); err != nil {
+		return "", trace.Wrap(err)
+	}
+	username, ok := r.Config.Users[userID]
+	if !ok || username == "" {
+		return "", trace.AccessDenied("your Slack account is not allowed to use Beams")
+	}
+
+	identityPath := filepath.Join(profileDir, "identity")
+	sessionPath := filepath.Join(profileDir, "delegation-session")
+
+	var args []string
+	switch words[0] {
+	case "connect":
+		if len(words) != 1 {
+			return "", trace.BadParameter("usage: /beams connect")
+		}
+		return r.startConnect(ctx, profileDir, sessionPath, username)
+	case "status":
+		if connectErr, err := os.ReadFile(filepath.Join(profileDir, "connect-error")); err == nil {
+			return "", trace.Errorf("Teleport connection failed: %s", strings.TrimSpace(string(connectErr)))
+		}
+		if _, err := os.Stat(sessionPath); err == nil {
+			return fmt.Sprintf("Connected to %s as %s using Machine ID delegation.", r.Config.Proxy, username), nil
+		}
+		return "Not connected. Run `/beams connect`.", nil
+	case "ls":
+		args = []string{"beams", "ls", "--format=json"}
+	case "add":
+		args = append([]string{"beams", "add", "--no-console", "--format=json"}, words[1:]...)
+	case "exec", "publish", "unpublish", "rm", "scp":
+		args = append([]string{"beams"}, words...)
+	case "ssh":
+		return "", trace.BadParameter("interactive SSH is unavailable in Slack; use /beams exec <name> <command>")
+	default:
+		return "", trace.BadParameter("unknown command %q\n%s", words[0], beamsHelp())
+	}
+
+	sessionID, err := os.ReadFile(sessionPath)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return "", trace.AccessDenied("not connected; run /beams connect")
+		}
+		return "", trace.Wrap(err)
+	}
+	if err := r.generateDelegatedIdentity(ctx, strings.TrimSpace(string(sessionID)), username, identityPath); err != nil {
+		return "", trace.Wrap(err, "refreshing delegated Beams identity")
+	}
+
+	timeout := defaultBeamsCommandTimeout
+	if r.Config.CommandTTL != "" {
+		timeout, err = time.ParseDuration(r.Config.CommandTTL)
+		if err != nil {
+			return "", trace.BadParameter("invalid beams.command_timeout: %v", err)
+		}
+	}
+	runCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+
+	tshArgs := append([]string{
+		"--proxy=" + r.Config.Proxy,
+		"--identity=" + identityPath,
+	}, args...)
+	cmd := exec.CommandContext(runCtx, r.Config.TSHPath, tshArgs...)
+	cmd.Env = append(os.Environ(), "TELEPORT_HOME="+profileDir)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	if err := cmd.Run(); err != nil {
+		if runCtx.Err() != nil {
+			return "", trace.LimitExceeded("command timed out")
+		}
+		return "", trace.Wrap(err, strings.TrimSpace(stderr.String()))
+	}
+	return truncateSlackOutput(stdout.String()), nil
+}
+
+func (r BeamsCommandRunner) startConnect(ctx context.Context, profileDir, sessionPath, username string) (string, error) {
+	if r.ConnectMu == nil {
+		return "", trace.BadParameter("connect coordinator is not configured")
+	}
+	if !r.ConnectMu.TryLock() {
+		return "", trace.CompareFailed("another Teleport login is already in progress; try again shortly")
+	}
+
+	loginDir := filepath.Join(profileDir, "login")
+	if err := os.RemoveAll(loginDir); err != nil {
+		r.ConnectMu.Unlock()
+		return "", trace.Wrap(err)
+	}
+	if err := os.MkdirAll(loginDir, 0o700); err != nil {
+		r.ConnectMu.Unlock()
+		return "", trace.Wrap(err)
+	}
+
+	loginCtx, cancelLogin := context.WithTimeout(context.Background(), 10*time.Minute)
+	args := []string{
+		"ls",
+		"--proxy=" + r.Config.Proxy,
+		"--user=" + username,
+		"--headless",
+		"--format=json",
+	}
+	cmd := exec.CommandContext(loginCtx, r.Config.TSHPath, args...)
+	cmd.Env = append(os.Environ(), "TELEPORT_HOME="+loginDir)
+	stderr, err := cmd.StderrPipe()
+	if err != nil {
+		cancelLogin()
+		r.ConnectMu.Unlock()
+		return "", trace.Wrap(err)
+	}
+	var stdout bytes.Buffer
+	cmd.Stdout = &stdout
+	if err := cmd.Start(); err != nil {
+		cancelLogin()
+		r.ConnectMu.Unlock()
+		return "", trace.Wrap(err)
+	}
+
+	scanner := bufio.NewScanner(stderr)
+	urlCh := make(chan string, 1)
+	resultCh := make(chan error, 1)
+	go func() {
+		defer cancelLogin()
+		defer r.ConnectMu.Unlock()
+		defer os.RemoveAll(loginDir)
+
+		var stderrLines []string
+		for scanner.Scan() {
+			line := scanner.Text()
+			stderrLines = append(stderrLines, line)
+			if loginURL := loginURLPattern.FindString(line); loginURL != "" {
+				select {
+				case urlCh <- loginURL:
+				default:
+				}
+			}
+		}
+		if err := cmd.Wait(); err != nil {
+			detail := strings.TrimSpace(strings.Join(stderrLines, "\n"))
+			connectErr := trace.Wrap(err, detail)
+			_ = os.WriteFile(filepath.Join(profileDir, "connect-error"), []byte(connectErr.Error()), 0o600)
+			resultCh <- connectErr
+			return
+		}
+		if err := r.finishConnect(loginCtx, loginDir, sessionPath, username); err != nil {
+			_ = os.WriteFile(filepath.Join(profileDir, "connect-error"), []byte(err.Error()), 0o600)
+			resultCh <- err
+			return
+		}
+		_ = os.Remove(filepath.Join(profileDir, "connect-error"))
+		resultCh <- nil
+	}()
+
+	select {
+	case loginURL := <-urlCh:
+		return fmt.Sprintf("Authenticate with Teleport: %s\nAfter login completes, run `/beams status`.", loginURL), nil
+	case err := <-resultCh:
+		if err != nil {
+			return "", trace.Wrap(err, "starting Teleport headless login")
+		}
+		return fmt.Sprintf("Connected to %s as %s using Machine ID delegation.", r.Config.Proxy, username), nil
+	case <-time.After(15 * time.Second):
+		return "", trace.ConnectionProblem(nil, "timed out waiting for Teleport login URL")
+	case <-ctx.Done():
+		return "", trace.Wrap(ctx.Err())
+	}
+}
+
+func (r BeamsCommandRunner) finishConnect(ctx context.Context, loginDir, sessionPath, username string) error {
+	statusCmd := exec.CommandContext(ctx, r.Config.TSHPath, "status", "--format=json")
+	statusCmd.Env = append(os.Environ(), "TELEPORT_HOME="+loginDir)
+	statusOutput, err := statusCmd.Output()
+	if err != nil {
+		return trace.Wrap(err, "checking Teleport login")
+	}
+	var status struct {
+		Active struct {
+			Username string `json:"username"`
+		} `json:"active"`
+	}
+	if err := json.Unmarshal(statusOutput, &status); err != nil {
+		return trace.Wrap(err, "decoding Teleport login status")
+	}
+	if status.Active.Username != username {
+		return trace.AccessDenied("Teleport login does not match mapped user %q", username)
+	}
+
+	delegationCmd := exec.CommandContext(ctx, r.Config.TSHPath,
+		"delegation", "create-session",
+		"--bot="+r.Config.BotName,
+		"--allow-all",
+		"--session-ttl="+r.Config.DelegationTTL,
+	)
+	delegationCmd.Env = append(os.Environ(), "TELEPORT_HOME="+loginDir)
+	output, err := delegationCmd.CombinedOutput()
+	if err != nil {
+		return trace.Wrap(err, strings.TrimSpace(string(output)))
+	}
+	match := regexp.MustCompile(`[0-9a-fA-F-]{36}`).Find(output)
+	if match == nil {
+		return trace.BadParameter("could not find delegation session ID in tsh output")
+	}
+	sessionID, err := uuid.Parse(string(match))
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if err := os.WriteFile(sessionPath, []byte(sessionID.String()), 0o600); err != nil {
+		return trace.Wrap(err)
+	}
+	return nil
+}
+
+func (r BeamsCommandRunner) generateDelegatedIdentity(ctx context.Context, sessionID, username, identityPath string) error {
+	if r.DelegationClient == nil {
+		return trace.BadParameter("delegation client is not configured")
+	}
+	ttl, err := time.ParseDuration(r.Config.IdentityTTL)
+	if err != nil {
+		return trace.BadParameter("invalid beams.identity_ttl: %v", err)
+	}
+	if ttl <= 0 || ttl > time.Hour {
+		return trace.BadParameter("beams.identity_ttl must be between 1s and 1h")
+	}
+
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	sshPublicKey, err := ssh.NewPublicKey(privateKey.Public())
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	tlsPublicKey, err := keys.MarshalPublicKey(privateKey.Public())
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	response, err := r.DelegationClient.GenerateCerts(ctx, &delegationv1.GenerateCertsRequest{
+		DelegationSessionId: sessionID,
+		SshPublicKey:        ssh.MarshalAuthorizedKey(sshPublicKey),
+		TlsPublicKey:        tlsPublicKey,
+		Ttl:                 durationpb.New(ttl),
+	})
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	certificate, _, err := keys.X509Certificate(response.GetTls())
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if certificate.Subject.CommonName != username {
+		return trace.AccessDenied("delegation session belongs to %q, expected %q", certificate.Subject.CommonName, username)
+	}
+
+	privateKeyPEM, err := keys.MarshalPrivateKey(privateKey)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	botIdentity, err := identityfile.ReadFile(r.Config.PluginIdentity)
+	if err != nil {
+		return trace.Wrap(err, "reading Machine ID identity")
+	}
+	delegatedIdentity := &identityfile.IdentityFile{
+		PrivateKey: privateKeyPEM,
+		Certs: identityfile.Certs{
+			SSH: response.GetSsh(),
+			TLS: response.GetTls(),
+		},
+		CACerts: botIdentity.CACerts,
+	}
+	if err := identityfile.Write(delegatedIdentity, identityPath); err != nil {
+		return trace.Wrap(err)
+	}
+	return nil
+}
+
+func beamsHelp() string {
+	return strings.TrimSpace(`/beams connect
+/beams status
+/beams ls
+/beams add [--region=<region>]
+/beams exec <name> <command...>
+/beams publish <name> [--tcp]
+/beams unpublish <name>
+/beams rm <name>
+/beams scp <src> <dst>`)
+}
+
+func truncateSlackOutput(s string) string {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return "Done."
+	}
+	const max = 2800
+	if len(s) > max {
+		return fmt.Sprintf("%s\n… output truncated", s[:max])
+	}
+	return s
+}
