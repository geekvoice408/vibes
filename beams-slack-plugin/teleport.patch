+	profile := filepath.Join(runner.Config.ProfilesDir, "T1", "UALICE")
+	require.NoError(t, os.WriteFile(filepath.Join(profile, "delegation-session"), []byte("99999999-2222-3333-4444-555555555555"), 0o600))
+	out, err = runner.Run(ctx, "T1", "UALICE", "ls")
+	require.NoError(t, err)
+	require.Contains(t, out, "Your authorization has expired.\n*Before we can get started")
+	out, err = runner.Run(ctx, "T1", "UALICE", "status")
+	require.NoError(t, err)
+	require.Equal(t, "Not connected. Run `/beams connect`.", out)
+}
+
+func TestBeamsRetryUntilReady(t *testing.T) {
+	oldPoll := beamReadyPoll
+	beamReadyPoll = 10 * time.Millisecond
+	t.Cleanup(func() { beamReadyPoll = oldPoll })
+
+	dir := t.TempDir()
+	counter := filepath.Join(dir, "attempts")
+	tshPath := filepath.Join(dir, "tsh")
+	script := `#!/bin/sh
+n=$(cat ` + counter + ` 2>/dev/null || echo 0)
+n=$((n+1))
+echo $n > ` + counter + `
+if [ $n -le 2 ]; then
+  echo 'ERROR: beam "fresh" is not ready to accept SSH connections' >&2
+  exit 1
+fi
+echo ready
+`
+	require.NoError(t, os.WriteFile(tshPath, []byte(script), 0o700))
+
+	s := beamsSession{
+		runner:     BeamsCommandRunner{Config: BeamsConfig{TSHPath: tshPath}},
+		profileDir: dir,
+	}
+	out, err := s.tsh(t.Context(), "/identity", "beams", "exec", "fresh", "true")
+	require.NoError(t, err)
+	require.Equal(t, "ready\n", out)
+	attempts, err := os.ReadFile(counter)
+	require.NoError(t, err)
+	require.Equal(t, "3\n", string(attempts))
+}
+
+func TestFailedCommandReportsOutput(t *testing.T) {
+	dir := t.TempDir()
+	tshPath := filepath.Join(dir, "tsh")
+	script := `#!/bin/sh
+echo "API Error: 403 invalid session"
+echo "ERROR: Process exited with status 1" >&2
+exit 1
+`
+	require.NoError(t, os.WriteFile(tshPath, []byte(script), 0o700))
+	s := beamsSession{runner: BeamsCommandRunner{Config: BeamsConfig{TSHPath: tshPath}}, profileDir: dir}
+	_, _, err := s.tshOnce(t.Context(), "/identity", "beams", "exec", "mine", "claude -p hi")
+	require.Error(t, err)
+	require.Contains(t, trace.UserMessage(err), "API Error: 403 invalid session")
+	require.Contains(t, trace.UserMessage(err), "Process exited with status 1")
+
+	require.Equal(t, "…"+strings.Repeat("b", maxFailureOutput-1)+"c", outputTail(strings.Repeat("a", 50)+strings.Repeat("b", maxFailureOutput-1)+"c\n"))
+}
diff --git a/integrations/access/slack/beams_files.go b/integrations/access/slack/beams_files.go
new file mode 100644
index 00000000000..13eb8f29840
--- /dev/null
+++ b/integrations/access/slack/beams_files.go
@@ -0,0 +1,114 @@
+package slack
+
+import (
+	"context"
+	"encoding/base64"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"github.com/gravitational/trace"
+)
+
+const (
+	// maxChatImages and maxChatImageSize keep a chat request with images under
+	// Teleport's 10 MiB limit for proxied model requests once base64-encoded.
+	maxChatImages    = 2
+	maxChatImageSize = 3500 << 10
+	// beamUploadDir is where attachments are copied in a beam.
+	beamUploadDir = "/tmp/slack-attachments"
+)
+
+// chatImageTypes are the image formats both model APIs accept.
+var chatImageTypes = map[string]bool{"image/jpeg": true, "image/png": true, "image/gif": true, "image/webp": true}
+
+var unsafeFileChars = regexp.MustCompile(`[^A-Za-z0-9._-]+`)
+
+// attachment is a file from a Slack message.
+type attachment struct {
+	Name     string
+	MimeType string
+	Data     []byte
+}
+
+type attachmentsKey struct{}
+
+// withAttachments attaches a message's downloaded files to the request.
+func withAttachments(ctx context.Context, files []attachment) context.Context {
+	return context.WithValue(ctx, attachmentsKey{}, files)
+}
+
+func attachmentsFrom(ctx context.Context) []attachment {
+	files, _ := ctx.Value(attachmentsKey{}).([]attachment)
+	return files
+}
+
+// chatImages returns the attachments a chat answer can include, and whether
+// every attachment fits. Anything else (other file types, large or many
+// images) needs a coding agent in a beam.
+func chatImages(files []attachment) (images []attachment, allFit bool) {
+	for _, f := range files {
+		if !chatImageTypes[f.MimeType] || len(f.Data) > maxChatImageSize || len(images) == maxChatImages {
+			return nil, false
+		}
+		images = append(images, f)
+	}
+	return images, true
+}
+
+// base64 encodes an attachment for the model APIs.
+func (a attachment) base64() string {
+	return base64.StdEncoding.EncodeToString(a.Data)
+}
+
+// describeAttachments notes attachments in text kept for chat history.
+func describeAttachments(text string, files []attachment) string {
+	for _, f := range files {
+		text += fmt.Sprintf("\n[attached %s]", f.Name)
+	}
+	return text
+}
+
+// uploadAttachments copies the request's attachments into the beam as the
+// user and returns their paths there.
+func (s beamsSession) uploadAttachments(ctx context.Context, beam string, files []attachment) ([]string, error) {
+	var paths []string
+	for _, f := range files {
+		name := unsafeFileChars.ReplaceAllString(filepath.Base(f.Name), "_")
+		if name == "" || name == "." || name == ".." {
+			name = "attachment"
+		}
+		local, err := os.CreateTemp(s.profileDir, "upload-*")
+		if err != nil {
+			return nil, trace.Wrap(err)
+		}
+		_, writeErr := local.Write(f.Data)
+		closeErr := local.Close()
+		if err := trace.NewAggregate(writeErr, closeErr); err != nil {
+			os.Remove(local.Name())
+			return nil, trace.Wrap(err)
+		}
+		remote := beamUploadDir + "/" + name
+		// tsh beams scp does not create directories, so make one first.
+		_, err = s.userTSH(ctx, "beams", "exec", beam, "mkdir -p "+beamUploadDir)
+		if err == nil {
+			_, err = s.userTSH(ctx, "beams", "scp", local.Name(), beam+":"+remote)
+		}
+		os.Remove(local.Name())
+		if err != nil {
+			return nil, trace.Wrap(err, "copying %s into beam %q", f.Name, beam)
+		}
+		paths = append(paths, remote)
+	}
+	return paths, nil
+}
+
+// attachmentPrompt tells the coding agent where the user's files are.
+func attachmentPrompt(paths []string) string {
+	if len(paths) == 0 {
+		return ""
+	}
+	return "The user attached these files, now in this runtime:\n- " + strings.Join(paths, "\n- ") + "\n"
+}
diff --git a/integrations/access/slack/beams_tell.go b/integrations/access/slack/beams_tell.go
new file mode 100644
index 00000000000..e82f25db53f
--- /dev/null
+++ b/integrations/access/slack/beams_tell.go
@@ -0,0 +1,145 @@
+package slack
+
+import (
+	"cmp"
+	"context"
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+
+	"github.com/gravitational/trace"
+
+	"github.com/gravitational/teleport/integrations/lib/logger"
+)
+
+// tellInstructions explains the tell action to the chat model and to coding
+// agents.
+const tellInstructions = `You can send Slack messages for the user. When they ask you to tell, notify, ping, or let someone know something, add one line per person:
+` + botActionPrefix + ` tell <person> :: <message>
+<person> is the name the user gave, or the <@ID> mention if they used one. Write <message> as a short note to that person with what the user asked you to pass on; if it is about a problem or incident, add that we're on it. The Slack bot sends it from the user and reports any problem, so never say you can't message people.`
+
+// mentionID matches a Slack user mention such as <@U123> or <@U123|anna>.
+var mentionID = regexp.MustCompile(`^<@([A-Z0-9]+)(?:\|[^>]*)?>$`)
+
+// SlackPerson is a Slack user the bot can send a message to for a user.
+type SlackPerson struct {
+	ID          string
+	Name        string
+	RealName    string
+	DisplayName string
+}
+
+func (p SlackPerson) label() string {
+	return cmp.Or(p.RealName, p.DisplayName, p.Name, p.ID)
+}
+
+// parseTell reads a "tell <person> :: <message>" action.
+func parseTell(action string) (who, message string, ok bool) {
+	rest, ok := strings.CutPrefix(action, "tell ")
+	if !ok {
+		return "", "", false
+	}
+	who, message, ok = strings.Cut(rest, "::")
+	who, message = strings.TrimSpace(who), strings.TrimSpace(message)
+	return who, message, ok && who != "" && message != ""
+}
+
+// matchPeople finds the Slack users a name refers to. A full name or handle
+// wins; otherwise a display name or any word of a name, such as a first
+// name. Display names alone are often just a first name, so they don't win.
+func matchPeople(people []SlackPerson, query string) []SlackPerson {
+	q := strings.ToLower(strings.TrimPrefix(strings.TrimSpace(query), "@"))
+	if q == "" {
+		return nil
+	}
+	var exact, partial []SlackPerson
+	for _, p := range people {
+		names := []string{strings.ToLower(p.RealName), strings.ToLower(p.DisplayName), strings.ToLower(p.Name)}
+		switch {
+		case q == names[0] || q == names[2]:
+			exact = append(exact, p)
+		case slices.ContainsFunc(names, func(name string) bool {
+			return slices.Contains(nameWords(name), q) || (strings.Contains(q, " ") && strings.HasPrefix(name, q))
+		}):
+			partial = append(partial, p)
+		}
+	}
+	if len(exact) > 0 {
+		return exact
+	}
+	return partial
+}
+
+func nameWords(name string) []string {
+	return strings.FieldsFunc(name, func(r rune) bool {
+		return r == ' ' || r == '.' || r == '_' || r == '-'
+	})
+}
+
+// tell sends a message to someone for the user. From a channel thread it is
+// posted in the thread with a mention, so they are notified there; from a
+// direct message with the bot it goes to them directly. told records who has
+// been messaged during this request so nobody gets the same note twice. It
+// returns a note for the user, empty when the message in the thread speaks
+// for itself.
+func (s beamsSession) tell(ctx context.Context, channel, threadTS, action string, told map[string]string) string {
+	who, message, ok := parseTell(action)
+	if !ok {
+		return ""
+	}
+	if s.runner.FindPeople == nil || s.runner.Post == nil {
+		return "I can't send Slack messages from here."
+	}
+	people, err := s.runner.FindPeople(ctx, who)
+	if err != nil {
+		logger.Get(ctx).WarnContext(ctx, "Failed to look up Slack users", "query", who, "error", err)
+		return fmt.Sprintf("I couldn't look up %s in Slack: %s", who, trace.UserMessage(err))
+	}
+	switch len(people) {
+	case 0:
+		return fmt.Sprintf("I couldn't find anyone in Slack called %s, so I didn't message them.", who)
+	case 1:
+	default:
+		var names []string
+		for _, p := range people[:min(len(people), 5)] {
+			names = append(names, p.label())
+		}
+		return fmt.Sprintf("More than one person matches %s (%s), so I didn't message anyone. Say which one, for example \"tell %s …\".",
+			who, strings.Join(names, ", "), names[0])
+	}
+	person := people[0]
+	if _, ok := told[person.ID]; ok {
+		return ""
+	}
+
+	direct := isDirectMessage(channel)
+	if direct {
+		err = s.runner.Post(ctx, person.ID, "", fmt.Sprintf("Message from <@%s>: %s", s.slackUserID, message))
+	} else {
+		err = s.runner.Post(ctx, channel, threadTS, fmt.Sprintf("<@%s> message from <@%s>: %s", person.ID, s.slackUserID, message))
+	}
+	if err != nil {
+		logger.Get(ctx).WarnContext(ctx, "Failed to send a Slack message for the user", "to_slack_user_id", person.ID, "error", err)
+		return fmt.Sprintf("I couldn't message %s: %s", person.label(), trace.UserMessage(err))
+	}
+	told[person.ID] = fmt.Sprintf("%s: %s", person.label(), message)
+	s.logRequest(ctx, "tell", message, "to_slack_user_id", person.ID)
+	if direct {
+		return fmt.Sprintf("Sent %s a direct message.", person.label())
+	}
+	return ""
+}
+
+// alreadyTold tells a coding agent which messages were sent before it ran.
+func alreadyTold(told map[string]string) string {
+	if len(told) == 0 {
+		return ""
+	}
+	lines := make([]string, 0, len(told))
+	for _, line := range told {
+		lines = append(lines, "- "+line)
+	}
+	slices.Sort(lines)
+	return "The Slack bot already sent these messages for the user, so don't send them again:\n" + strings.Join(lines, "\n") + "\n"
+}
diff --git a/integrations/access/slack/beams_tell_test.go b/integrations/access/slack/beams_tell_test.go
