+
+package slack
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+
+	"github.com/gravitational/trace"
+
+	delegationv1 "github.com/gravitational/teleport/api/gen/proto/go/teleport/delegation/v1"
+	"github.com/gravitational/teleport/integrations/access/common"
+	"github.com/gravitational/teleport/integrations/lib"
+	"github.com/gravitational/teleport/integrations/lib/logger"
+)
+
+// BeamsBot defines the Slack operations used by the Beams slash-command app.
+type BeamsBot interface {
+	GenerateWebSocketURL(ctx context.Context) (string, error)
+	PostBeamsReply(ctx context.Context, responseURL, text string) error
+	LookupEmailByUserID(ctx context.Context, userID string) (string, error)
+}
+
+type beamsRunner interface {
+	Run(ctx context.Context, teamID, userID, text string) (string, error)
+}
+
+// BeamsApp consumes /beams commands from Slack Socket Mode.
+type BeamsApp struct {
+	conf             BeamsConfig
+	bot              BeamsBot
+	runner           beamsRunner
+	socketModeClient *SocketModeClient
+	job              lib.ServiceJob
+}
+
+// NewBeamsApp creates a Beams slash-command application.
+func NewBeamsApp(conf BeamsConfig) *BeamsApp {
+	app := &BeamsApp{
+		conf:   conf,
+		runner: BeamsCommandRunner{Config: conf},
+	}
+	app.job = lib.NewServiceJob(app.run)
+	return app
+}
+
+// Init initializes the Slack bot and Socket Mode client.
+func (a *BeamsApp) Init(baseApp *common.BaseApp) error {
+	var ok bool
+	a.bot, ok = baseApp.Bot.(BeamsBot)
+	if !ok {
+		return trace.BadParameter("bot does not support Beams slash commands")
+	}
+	a.socketModeClient = NewSocketModeClient(a.bot)
+	delegationClient, ok := baseApp.APIClient.(interface {
+		DelegationSessionServiceClient() delegationv1.DelegationSessionServiceClient
+	})
+	if !ok {
+		return trace.BadParameter("Teleport client does not support delegation sessions")
+	}
+	a.runner = BeamsCommandRunner{
+		Config:           a.conf,
+		DelegationClient: delegationClient.DelegationSessionServiceClient(),
+		LookupEmail:      a.bot.LookupEmailByUserID,
+		Users:            baseApp.APIClient,
+		IndexMu:          &sync.Mutex{},
+	}
+	return nil
+}
+
+// Start starts the application.
+func (a *BeamsApp) Start(process *lib.Process) {
+	process.SpawnCriticalJob(a.job)
+}
+
+// WaitReady waits until the application is ready.
+func (a *BeamsApp) WaitReady(ctx context.Context) (bool, error) {
+	return a.job.WaitReady(ctx)
+}
+
+// WaitForDone waits for the application to stop.
+func (a *BeamsApp) WaitForDone() {
+	<-a.job.Done()
+}
+
+// Err returns the application error.
+func (a *BeamsApp) Err() error {
+	return a.job.Err()
+}
+
+func (a *BeamsApp) run(ctx context.Context) error {
+	process := lib.MustGetProcess(ctx)
+	ctx, cancel := context.WithCancel(ctx)
+	process.OnTerminate(func(context.Context) error {
+		cancel()
+		return nil
+	})
+
+	log := logger.Get(ctx)
+	a.job.SetReady(true)
+	log.InfoContext(ctx, "Beams slash-command app is running")
+
+	go func() {
+		for {
+			select {
+			case interaction := <-a.socketModeClient.Interactions():
+				event, ok := interaction.(SlashCommandEvent)
+				if !ok {
+					continue
+				}
+				if event.Command != "/beams" {
+					continue
+				}
+				go a.handleSlashCommand(ctx, event)
+			case <-ctx.Done():
+				return
+			}
+		}
+	}()
+
+	return trace.Wrap(a.socketModeClient.Run(ctx))
+}
+
+func (a *BeamsApp) handleSlashCommand(ctx context.Context, event SlashCommandEvent) {
+	log := logger.Get(ctx).With(
+		"slack_team_id", event.TeamID,
+		"slack_user_id", event.UserID,
+		"slack_channel_id", event.ChannelID,
+	)
+	log.InfoContext(ctx, "Executing Beams slash command")
+
+	if fields := strings.Fields(event.Text); len(fields) > 1 && fields[0] == "claude" {
+		notice := fmt.Sprintf("Running Claude Code in `%s`. This can take a few minutes.", fields[1])
+		if err := a.bot.PostBeamsReply(ctx, event.ResponseURL, notice); err != nil {
+			log.WarnContext(ctx, "Failed to post Beams progress notice", "error", err)
+		}
+	}
+
+	output, err := a.runner.Run(ctx, event.TeamID, event.UserID, event.Text)
+	if err != nil {
+		output = fmt.Sprintf("Beams command failed: %s", trace.UserMessage(err))
+		log.WarnContext(ctx, "Beams slash command failed", "error", err)
+	}
+
+	if err := a.bot.PostBeamsReply(ctx, event.ResponseURL, formatBeamsReply(output)); err != nil {
+		log.ErrorContext(ctx, "Failed to post Beams command response", "error", err)
+	}
+}
+
+func formatBeamsReply(output string) string {
+	output = strings.TrimSpace(output)
+	if strings.HasPrefix(output, "/beams ") || !strings.Contains(output, "\n") {
+		return output
+	}
+	return "```" + output + "```"
+}
diff --git a/integrations/access/slack/beams_commands.go b/integrations/access/slack/beams_commands.go
new file mode 100644
index 00000000000..3dc26ae77d4
--- /dev/null
+++ b/integrations/access/slack/beams_commands.go
@@ -0,0 +1,613 @@
+package slack
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"encoding/json"
+	"fmt"
+	"maps"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/gravitational/trace"
+	"github.com/mattn/go-shellwords"
+	"golang.org/x/crypto/ssh"
+	"google.golang.org/protobuf/types/known/durationpb"
+
+	delegationv1 "github.com/gravitational/teleport/api/gen/proto/go/teleport/delegation/v1"
+	"github.com/gravitational/teleport/api/identityfile"
+	"github.com/gravitational/teleport/api/utils/keys"
+	"github.com/gravitational/teleport/lib/services"
+)
+
+const (
+	defaultBeamsCommandTimeout = 2 * time.Minute
+	defaultClaudeTimeout       = 15 * time.Minute
+)
+
+// defaultClaudeArgs lets Claude Code run tools without interactive approval,
+// which print mode cannot ask for. Beams are ephemeral sandbox VMs.
+var defaultClaudeArgs = []string{"--dangerously-skip-permissions"}
+
+// botBeamsFile lists, one per line, the beams a Slack user created through the
+// shared bot identity. Teleport records the bot as their owner, so the plugin
+// uses this index to keep each user's bot-owned beams private in Slack.
+const botBeamsFile = "bot-beams"
+
+var (
+	safeSlackID = regexp.MustCompile(`^[A-Z0-9]+$`)
+	ansiEscape  = regexp.MustCompile(`\x1b\[[0-9;]*[A-Za-z]`)
+)
+
+// BeamsCommandRunner executes non-interactive tsh beams commands for one Slack
+// user. Users who connected a delegation session act as their own Teleport
+// user; everyone else shares the plugin's bot identity, filtered per user.
+type BeamsCommandRunner struct {
+	Config           BeamsConfig
+	DelegationClient delegationv1.DelegationSessionServiceClient
+	// LookupEmail returns the email address of a Slack user.
+	LookupEmail func(ctx context.Context, userID string) (string, error)
+	// Users reads Teleport users to authorize Slack users by role.
+	Users services.UserOrLoginStateGetter
+	// IndexMu serializes updates to per-user bot beam indexes.
+	IndexMu *sync.Mutex
+}
+
+// beamsSession is the per-command execution context for one Slack user.
+type beamsSession struct {
+	runner      BeamsCommandRunner
+	profileDir  string
+	username    string
+	delegation  string
+	sessionPath string
+	// timeout overrides beams.command_timeout when set.
+	timeout time.Duration
+}
+
+func (r BeamsCommandRunner) Run(ctx context.Context, teamID, userID, text string) (string, error) {
+	if !safeSlackID.MatchString(teamID) || !safeSlackID.MatchString(userID) {
+		return "", trace.BadParameter("invalid Slack identity")
+	}
+	words, err := shellwords.Parse(text)
+	if err != nil {
+		return "", trace.BadParameter("invalid command: %v", err)
+	}
+	if len(words) == 0 || words[0] == "help" {
+		return beamsHelp(), nil
+	}
+
+	profileDir := filepath.Join(r.Config.ProfilesDir, teamID, userID)
+	if err := os.MkdirAll(profileDir, 0o700); err != nil {
+		return "", trace.Wrap(err)
+	}
+	username, err := r.resolveUser(ctx, userID)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	s := beamsSession{
+		runner:      r,
+		profileDir:  profileDir,
+		username:    username,
+		sessionPath: filepath.Join(profileDir, "delegation-session"),
+	}
+	if sessionID, err := os.ReadFile(s.sessionPath); err == nil {
+		s.delegation = strings.TrimSpace(string(sessionID))
+	} else if !os.IsNotExist(err) {
+		return "", trace.Wrap(err)
+	}
+
+	switch words[0] {
+	case "connect":
+		return s.connect(ctx, words[1:])
+	case "disconnect":
+		if err := os.Remove(s.sessionPath); err != nil && !os.IsNotExist(err) {
+			return "", trace.Wrap(err)
+		}
+		return "Disconnected. New beams will be created by the shared bot and visible only to you in Slack.", nil
+	case "status":
+		if s.delegation != "" {
+			return fmt.Sprintf("Connected to %s as %s. New beams are owned by your Teleport user.", r.Config.Proxy, username), nil
+		}
+		return fmt.Sprintf("Using the shared bot on %s; your beams are visible only to you in Slack. Run `/beams connect` to own new beams as %s.", r.Config.Proxy, username), nil
+	case "ls":
+		return s.list(ctx)
+	case "add":
+		return s.add(ctx, words[1:])
+	case "exec", "publish", "unpublish", "rm", "scp":
+		return s.target(ctx, words)
+	case "claude":
+		return s.claude(ctx, words[1:])
+	case "ssh":
+		return "", trace.BadParameter("interactive SSH is unavailable in Slack; use /beams exec <name> <command>")
+	default:
+		return "", trace.BadParameter("unknown command %q\n%s", words[0], beamsHelp())
+	}
+}
+
+func (s beamsSession) connect(ctx context.Context, args []string) (string, error) {
+	if s.runner.Config.BotName == "" {
+		return "", trace.BadParameter("delegation is not configured; set beams.bot_name")
+	}
+	if len(args) == 0 {
+		return s.runner.connectInstructions(), nil
+	}
+	if len(args) != 1 {
+		return "", trace.BadParameter("usage: /beams connect [<delegation-session-id>]")
+	}
+	sessionID, err := uuid.Parse(args[0])
+	if err != nil {
+		return "", trace.BadParameter("invalid delegation session ID")
+	}
+	s.delegation = sessionID.String()
+	// Minting a certificate proves the session is valid, belongs to the
+	// mapped user, and was granted to this bot.
+	_, cleanup, err := s.userIdentity(ctx)
+	if err != nil {
+		return "", trace.Wrap(err, "validating delegation session")
+	}
+	cleanup()
+	if err := os.WriteFile(s.sessionPath, []byte(s.delegation), 0o600); err != nil {
+		return "", trace.Wrap(err)
+	}
+	return fmt.Sprintf("Connected to %s as %s. New beams will be owned by your Teleport user.", s.runner.Config.Proxy, s.username), nil
+}
+
+// list shows the user's delegated beams plus the bot-owned beams they created.
+func (s beamsSession) list(ctx context.Context) (string, error) {
+	botOutput, err := s.tsh(ctx, s.runner.Config.PluginIdentity, "beams", "ls", "--format=json")
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	botBeams, err := decodeBeams(botOutput)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	owned, err := s.pruneIndex(botBeams)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	beams := filterBeams(botBeams, owned)
+
+	if s.delegation != "" {
+		identityPath, cleanup, err := s.userIdentity(ctx)
+		if err != nil {
+			return "", trace.Wrap(err)
+		}
+		defer cleanup()
+		userOutput, err := s.tsh(ctx, identityPath, "beams", "ls", "--format=json")
+		if err != nil {
+			return "", trace.Wrap(err)
+		}
+		userBeams, err := decodeBeams(userOutput)
+		if err != nil {
+			return "", trace.Wrap(err)
+		}
+		beams = append(beams, userBeams...)
+	}
+
+	if len(beams) == 0 {
+		return "No beams. Create one with `/beams add`.", nil
+	}
+	out, err := json.MarshalIndent(beams, "", "  ")
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	return truncateSlackOutput(string(out)), nil
+}
+
+func (s beamsSession) add(ctx context.Context, args []string) (string, error) {
+	tshArgs := append([]string{"beams", "add", "--no-console", "--format=json"}, args...)
+	if s.delegation != "" {
+		identityPath, cleanup, err := s.userIdentity(ctx)
+		if err != nil {
+			return "", trace.Wrap(err)
+		}
+		defer cleanup()
+		out, err := s.tsh(ctx, identityPath, tshArgs...)
+		if err != nil {
+			return "", trace.Wrap(err)
+		}
+		return truncateSlackOutput(out), nil
+	}
+
+	out, err := s.tsh(ctx, s.runner.Config.PluginIdentity, tshArgs...)
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	var beam struct {
+		ID string `json:"id"`
+	}
+	if err := json.Unmarshal([]byte(out), &beam); err != nil || beam.ID == "" {
+		return "", trace.BadParameter("beam was created but its name could not be read from tsh output; it is not visible in Slack")
+	}
+	if err := s.updateIndex(func(owned map[string]bool) { owned[beam.ID] = true }); err != nil {
+		return "", trace.Wrap(err)
+	}
+	return truncateSlackOutput(out), nil
+}
+
+// target runs a command that acts on named beams. Bot-owned beams are allowed
+// only when this user created them; anything else runs as the user's
+// delegated identity, where Teleport enforces ownership.
+func (s beamsSession) target(ctx context.Context, words []string) (string, error) {
+	names := beamTargets(words)
+	if len(names) == 0 {
+		return "", trace.BadParameter("usage: /beams %s <name> ...", words[0])
+	}
+	owned, err := s.readIndex()
+	if err != nil {
+		return "", trace.Wrap(err)
+	}
+	botOwned := 0
+	for _, name := range names {
+		if owned[name] {
+			botOwned++
+		}
+	}
+
+	tshArgs := append([]string{"beams"}, words...)
+	switch {
+	case botOwned == len(names):
+		out, err := s.tsh(ctx, s.runner.Config.PluginIdentity, tshArgs...)
+		if err != nil {
+			return "", trace.Wrap(err)
+		}
+		if words[0] == "rm" {
+			if err := s.updateIndex(func(owned map[string]bool) { delete(owned, names[0]) }); err != nil {
+				return "", trace.Wrap(err)
+			}
+		}
+		return truncateSlackOutput(out), nil
+	case botOwned == 0 && s.delegation != "":
+		identityPath, cleanup, err := s.userIdentity(ctx)
+		if err != nil {
+			return "", trace.Wrap(err)
+		}
+		defer cleanup()
+		out, err := s.tsh(ctx, identityPath, tshArgs...)
+		if err != nil {
+			return "", trace.Wrap(err)
+		}
+		return truncateSlackOutput(out), nil
+	case botOwned == 0:
+		return "", trace.NotFound("you have no beam named %q", names[0])
+	default:
+		return "", trace.BadParameter("cannot mix bot-owned and user-owned beams in one command")
+	}
+}
+
+// claude runs Claude Code in print mode inside a beam and returns its answer.
+func (s beamsSession) claude(ctx context.Context, args []string) (string, error) {
+	if len(args) < 2 {
+		return "", trace.BadParameter("usage: /beams claude <name> [--continue] <prompt...>")
+	}
+	name, args := args[0], args[1:]
+	extraArgs := s.runner.Config.ClaudeArgs
+	if extraArgs == nil {
+		extraArgs = defaultClaudeArgs
+	}
+	claudeArgs := append([]string{"claude", "-p"}, extraArgs...)
+	if args[0] == "--continue" || args[0] == "-c" {
+		claudeArgs = append(claudeArgs, "--continue")
+		args = args[1:]
+	}
+	if len(args) == 0 {
+		return "", trace.BadParameter("usage: /beams claude <name> [--continue] <prompt...>")
+	}
+	claudeArgs = append(claudeArgs, strings.Join(args, " "))
+
+	s.timeout = defaultClaudeTimeout
+	if s.runner.Config.ClaudeTimeout != "" {
+		timeout, err := time.ParseDuration(s.runner.Config.ClaudeTimeout)
+		if err != nil {
+			return "", trace.BadParameter("invalid beams.claude_timeout: %v", err)
+		}
+		s.timeout = timeout
+	}
+	// The remote side runs the command through a shell, so pass one quoted
+	// command string rather than separate arguments.
+	return s.target(ctx, []string{"exec", name, shellQuoteJoin(claudeArgs)})
+}
+
+// shellQuoteJoin quotes each argument for a POSIX shell.
+func shellQuoteJoin(args []string) string {
+	quoted := make([]string, len(args))
+	for i, arg := range args {
+		quoted[i] = "'" + strings.ReplaceAll(arg, "'", `'\''`) + "'"
+	}
+	return strings.Join(quoted, " ")
+}
+
+// userIdentity mints a short-lived identity for the user's delegation session
+// into a private temporary file.
+func (s beamsSession) userIdentity(ctx context.Context) (string, func(), error) {
+	f, err := os.CreateTemp(s.profileDir, "identity-*")
+	if err != nil {
+		return "", nil, trace.Wrap(err)
+	}
+	path := f.Name()
+	_ = f.Close()
+	cleanup := func() { _ = os.Remove(path) }
+	if err := s.runner.generateDelegatedIdentity(ctx, s.delegation, s.username, path); err != nil {
+		cleanup()
+		return "", nil, trace.Wrap(err, "your delegation session is no longer usable; run /beams connect again, or /beams disconnect to use the shared bot")
+	}
+	return path, cleanup, nil
+}
+
+func (s beamsSession) tsh(ctx context.Context, identityPath string, args ...string) (string, error) {
+	timeout := defaultBeamsCommandTimeout
+	if s.timeout > 0 {
+		timeout = s.timeout
+	} else if s.runner.Config.CommandTTL != "" {
+		var err error
+		timeout, err = time.ParseDuration(s.runner.Config.CommandTTL)
+		if err != nil {
+			return "", trace.BadParameter("invalid beams.command_timeout: %v", err)
+		}
+	}
+	runCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+
+	tshArgs := append([]string{
+		"--proxy=" + s.runner.Config.Proxy,
+		"--identity=" + identityPath,
+	}, args...)
+	cmd := exec.CommandContext(runCtx, s.runner.Config.TSHPath, tshArgs...)
+	cmd.Env = append(os.Environ(), "TELEPORT_HOME="+s.profileDir, "NO_COLOR=1")
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	if err := cmd.Run(); err != nil {
+		if runCtx.Err() != nil {
+			return "", trace.LimitExceeded("command timed out")
+		}
+		return "", trace.Wrap(err, stripANSI(strings.TrimSpace(stderr.String())))
+	}
+	return stripANSI(stdout.String()), nil
+}
+
+func (s beamsSession) indexPath() string {
+	return filepath.Join(s.profileDir, botBeamsFile)
+}
+
+func (s beamsSession) readIndex() (map[string]bool, error) {
+	data, err := os.ReadFile(s.indexPath())
+	if os.IsNotExist(err) {
+		return map[string]bool{}, nil
+	}
+	if err != nil {
+		return nil, trace.Wrap(err)
+	}
+	owned := map[string]bool{}
+	for _, name := range strings.Fields(string(data)) {
+		owned[name] = true
+	}
+	return owned, nil
+}
+
+func (s beamsSession) updateIndex(update func(map[string]bool)) error {
+	s.runner.IndexMu.Lock()
+	defer s.runner.IndexMu.Unlock()
+	owned, err := s.readIndex()
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	update(owned)
+	names := make([]string, 0, len(owned))
+	for name := range owned {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+	return trace.Wrap(os.WriteFile(s.indexPath(), []byte(strings.Join(names, "\n")), 0o600))
+}
+
+// pruneIndex drops beams that no longer exist, such as expired ones, and
+// returns the remaining set.
+func (s beamsSession) pruneIndex(botBeams []map[string]any) (map[string]bool, error) {
+	existing := map[string]bool{}
+	for _, beam := range botBeams {
+		if id, _ := beam["id"].(string); id != "" {
+			existing[id] = true
+		}
+	}
+	var remaining map[string]bool
+	err := s.updateIndex(func(owned map[string]bool) {
+		for name := range owned {
+			if !existing[name] {
+				delete(owned, name)
+			}
+		}
+		remaining = maps.Clone(owned)
+	})
+	return remaining, trace.Wrap(err)
+}
+
+func decodeBeams(output string) ([]map[string]any, error) {
+	var beams []map[string]any
+	if strings.TrimSpace(output) == "" {
+		return nil, nil
+	}
+	if err := json.Unmarshal([]byte(output), &beams); err != nil {
+		return nil, trace.Wrap(err, "decoding tsh beams ls output")
+	}
+	return beams, nil
+}
+
+func filterBeams(beams []map[string]any, owned map[string]bool) []map[string]any {
+	var filtered []map[string]any
+	for _, beam := range beams {
+		if id, _ := beam["id"].(string); owned[id] {
+			filtered = append(filtered, beam)
+		}
+	}
+	return filtered
+}
+
+// beamTargets returns the beam names a command acts on: the first positional
+// argument, or for scp the host part of every <beam>:<path> argument.
+func beamTargets(words []string) []string {
+	var names []string
+	for _, word := range words[1:] {
+		if strings.HasPrefix(word, "-") {
+			continue
+		}
+		if words[0] != "scp" {
+			return []string{word}
+		}
+		if name, _, ok := strings.Cut(word, ":"); ok && name != "" {
+			names = append(names, name)
+		}
+	}
+	return names
+}
+
+func stripANSI(s string) string {
+	return ansiEscape.ReplaceAllString(s, "")
+}
+
+// resolveUser maps a Slack user to the Teleport username it acts for. Explicit
+// beams.users entries win; otherwise the Slack email must name a Teleport user
+// holding beams.required_role.
+func (r BeamsCommandRunner) resolveUser(ctx context.Context, slackUserID string) (string, error) {
+	if username, ok := r.Config.Users[slackUserID]; ok && username != "" {
+		return username, nil
+	}
+	if r.Config.RequiredRole == "" || r.LookupEmail == nil || r.Users == nil {
+		return "", trace.AccessDenied("your Slack account is not allowed to use Beams")
+	}
+
+	email, err := r.LookupEmail(ctx, slackUserID)
+	if err != nil {
+		return "", trace.Wrap(err, "looking up Slack email (the Slack app needs users:read.email)")
+	}
+	if email == "" {
+		return "", trace.AccessDenied("your Slack profile has no email address; the Slack app needs users:read.email")
+	}
+
+	user, err := services.GetUserOrLoginState(ctx, r.Users, email)
+	if trace.IsNotFound(err) {
+		return "", trace.AccessDenied("no Teleport user %q; sign in to Teleport once, then retry", email)
+	}
+	if err != nil {
+		return "", trace.Wrap(err, "looking up Teleport user %q", email)
+	}
+	if user.IsBot() || !slices.Contains(user.GetRoles(), r.Config.RequiredRole) {
+		return "", trace.AccessDenied("Teleport user %q does not have the %q role", email, r.Config.RequiredRole)
+	}
+	return email, nil
+}
+
+// connectInstructions tells the user how to authorize the Machine ID bot from
+// their own tsh session. Teleport handles SSO and MFA locally, so the plugin
+// never needs to broker a user login.
+func (r BeamsCommandRunner) connectInstructions() string {
+	createCommand := fmt.Sprintf(
+		"tsh delegation create-session --proxy=%s --bot=%s --allow-all --session-ttl=%s",
+		r.Config.Proxy,
+		r.Config.BotName,
+		r.Config.DelegationTTL,
+	)
+	return fmt.Sprintf(
+		"To own new beams as your Teleport user, authorize the %s bot from a terminal where you are signed in to Teleport:\n```%s```\n\nThen run `/beams connect <delegation-session-id>` with the ID it prints.",
+		r.Config.BotName,
+		createCommand,
+	)
+}
+
+func (r BeamsCommandRunner) generateDelegatedIdentity(ctx context.Context, sessionID, username, identityPath string) error {
+	if r.DelegationClient == nil {
+		return trace.BadParameter("delegation client is not configured")
+	}
+	ttl, err := time.ParseDuration(r.Config.IdentityTTL)
+	if err != nil {
+		return trace.BadParameter("invalid beams.identity_ttl: %v", err)
+	}
+	if ttl <= 0 || ttl > time.Hour {
+		return trace.BadParameter("beams.identity_ttl must be between 1s and 1h")
+	}
+
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	sshPublicKey, err := ssh.NewPublicKey(privateKey.Public())
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	tlsPublicKey, err := keys.MarshalPublicKey(privateKey.Public())
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	response, err := r.DelegationClient.GenerateCerts(ctx, &delegationv1.GenerateCertsRequest{
+		DelegationSessionId: sessionID,
+		SshPublicKey:        ssh.MarshalAuthorizedKey(sshPublicKey),
+		TlsPublicKey:        tlsPublicKey,
+		Ttl:                 durationpb.New(ttl),
+	})
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	certificate, _, err := keys.X509Certificate(response.GetTls())
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	if certificate.Subject.CommonName != username {
+		return trace.AccessDenied("delegation session belongs to %q, expected %q", certificate.Subject.CommonName, username)
+	}
+
+	privateKeyPEM, err := keys.MarshalPrivateKey(privateKey)
+	if err != nil {
+		return trace.Wrap(err)
+	}
+	botIdentity, err := identityfile.ReadFile(r.Config.PluginIdentity)
+	if err != nil {
+		return trace.Wrap(err, "reading Machine ID identity")
+	}
+	delegatedIdentity := &identityfile.IdentityFile{
+		PrivateKey: privateKeyPEM,
+		Certs: identityfile.Certs{
+			SSH: response.GetSsh(),
+			TLS: response.GetTls(),
+		},
+		CACerts: botIdentity.CACerts,
+	}
+	if err := identityfile.Write(delegatedIdentity, identityPath); err != nil {
+		return trace.Wrap(err)
+	}
+	return nil
+}
+
+func beamsHelp() string {
+	return strings.TrimSpace(`/beams connect [<delegation-session-id>]
+/beams disconnect
+/beams status
+/beams ls
+/beams add [--region=<region>]
+/beams exec <name> <command...>
+/beams claude <name> [--continue] <prompt...>
+/beams publish <name> [--tcp]
+/beams unpublish <name>
+/beams rm <name>
+/beams scp <src> <dst>`)
+}
+
+func truncateSlackOutput(s string) string {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return "Done."
+	}
+	const max = 2800
+	if len(s) > max {
+		return fmt.Sprintf("%s\n… output truncated", s[:max])
+	}
+	return s
+}
