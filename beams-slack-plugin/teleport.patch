+// writeFakeTSH installs a tsh stand-in that serves a fixed set of bot-owned
+// beams and records every invocation.
+func writeFakeTSH(t *testing.T) (tshPath, logPath string) {
+	dir := t.TempDir()
+	logPath = filepath.Join(dir, "calls")
+	tshPath = filepath.Join(dir, "tsh")
+	script := `#!/bin/sh
+echo "$@" >> ` + logPath + `
+case "$3 $4" in
+"beams ls") echo '[{"id":"mine","owner":"access-plugin"},{"id":"theirs","owner":"access-plugin"}]' ;;
+"beams add") echo '{"id":"mine","owner":"access-plugin"}' ;;
+*) echo ok ;;
+esac
+`
+	require.NoError(t, os.WriteFile(tshPath, []byte(script), 0o700))
+	return tshPath, logPath
+}
+
+func TestBeamsBotOwnedIsolation(t *testing.T) {
+	tshPath, logPath := writeFakeTSH(t)
+	runner := BeamsCommandRunner{
+		Config: BeamsConfig{
+			TSHPath:        tshPath,
+			Proxy:          "example.teleport.sh:443",
+			PluginIdentity: "/plugin-identity",
+			ProfilesDir:    t.TempDir(),
+			Users: map[string]string{
+				"UALICE": "alice@example.com",
+				"UBOB":   "bob@example.com",
+			},
+		},
+		IndexMu: &sync.Mutex{},
+	}
+	ctx := t.Context()
+
+	_, err := runner.Run(ctx, "T1", "UALICE", "add")
+	require.NoError(t, err)
+
+	out, err := runner.Run(ctx, "T1", "UALICE", "ls")
+	require.NoError(t, err)
+	require.Contains(t, out, `"mine"`)
+	require.NotContains(t, out, `"theirs"`)
+
+	out, err = runner.Run(ctx, "T1", "UBOB", "ls")
+	require.NoError(t, err)
+	require.Equal(t, "No beams. Create one with `/beams add`.", out)
+
+	_, err = runner.Run(ctx, "T1", "UBOB", "exec mine uname -a")
+	require.True(t, trace.IsNotFound(err), "expected not found, got %v", err)
+	_, err = runner.Run(ctx, "T1", "UALICE", "exec theirs uname -a")
+	require.True(t, trace.IsNotFound(err), "expected not found, got %v", err)
+
+	_, err = runner.Run(ctx, "T1", "UALICE", "exec mine uname -a")
+	require.NoError(t, err)
+	_, err = runner.Run(ctx, "T1", "UALICE", `claude mine --continue "what's failing?"`)
+	require.NoError(t, err)
+	_, err = runner.Run(ctx, "T1", "UBOB", "claude mine hello")
+	require.True(t, trace.IsNotFound(err), "expected not found, got %v", err)
+	_, err = runner.Run(ctx, "T1", "UALICE", "rm mine")
+	require.NoError(t, err)
+	_, err = runner.Run(ctx, "T1", "UALICE", "exec mine uname -a")
+	require.True(t, trace.IsNotFound(err), "expected not found after rm, got %v", err)
+
+	calls, err := os.ReadFile(logPath)
+	require.NoError(t, err)
+	require.NotContains(t, string(calls), "exec theirs")
+	require.Contains(t, string(calls), "--identity=/plugin-identity beams exec mine uname -a")
+	require.Contains(t, string(calls), `beams exec mine 'claude' '-p' '--dangerously-skip-permissions' '--continue' 'what'\''s failing?'`)
+}
