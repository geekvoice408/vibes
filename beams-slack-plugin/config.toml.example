[teleport]
addr = "example.teleport.sh:443"
identity = "/var/lib/teleport-slack/plugin-identity"

[slack]
token = "/var/lib/teleport-slack/slack-bot-token"

[review]
enabled = false
app_token = "/var/lib/teleport-slack/slack-app-token"

[beams]
enabled = true
tsh_path = "/usr/local/bin/tsh"
proxy = "example.teleport.sh:443"
plugin_identity = "/var/lib/teleport-slack/plugin-identity"
profiles_dir = "/var/lib/teleport-slack/beams"
identity_ttl = "15m"
command_timeout = "2m"
bot_name = "beams-slack"
delegation_ttl = "1h"

[beams.users]
"U0123456789" = "alice@example.com"

[role_to_recipients]
"*" = ["beams-access"]

[log]
output = "stderr"
severity = "INFO"
